# notesync 环境变量模板
# 复制为 .env后填写实际值
# 所有 Provider 配置均通过环境变量注入
#
# 【2026-11 更新】harness/agent/rag/OCR/PDF 旧诊断链路已注释停用，
# 旧参数仅被死代码读取，已注释保留原文（不再生效）。

# ---- DeepSeek（OpenAI 兼容，端点 {BASE_URL}/chat/completions，Bearer 鉴权）----
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- 智谱 AI / BigModel（OpenAI Chat Completion 兼容，端点 {BASE_URL}/chat/completions，Bearer 鉴权）----
ZHIPU_API_KEY=your_zhipu_api_key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.3

# ---- 自定义模型（仅实现 OpenAI API 规范）----
CUSTOM_API_KEY=your_custom_api_key
CUSTOM_BASE_URL=https://your-openai-compatible-endpoint.example.com/v1
CUSTOM_MODEL=your_model_name

# ---- 工具调用配置 ----
# 是否启用模型工具调用能力，默认为 true
TOOLS_ENABLED=true
# 工具调用最大循环轮数，防止无限循环，默认 3
TOOL_MAX_ROUNDS=3
# 自定义模型（CUSTOM）的工具调用模式：native（原生 tools 协议）| text（文本 JSON 协议）
CUSTOM_TOOL_MODE=native

# ---- 诊断模式适配层调试开关 ----
# 置 1 时 /api/chat 不调用任何上游模型，仅把组装好的发送结构回显为摘要，
# 用于零 token 验证「上传文件 → 组装消息 → 发送」链路是否正常。默认关闭。
MOCK_MODEL=0
# MOCK 下的图片投喂方式：留空或 multimodal（直传 image_url）| text-only（降级为文字占位）
MOCK_IMAGE_MODE=

# =====================================================================
# 【历史遗留参数 - 已注释停用，保留原文便于恢复】
# 以下参数对应已停用的旧链路（lib/harness、lib/agent、lib/rag、lib/ocr.ts、lib/pdf.ts），
# 当前简易版代码不再读取它们。如需恢复旧链路，取消注释并配套还原对应源码。
# =====================================================================
# ---- OCR 识别方式（纯文本模型只支持本地 OCR）----
# 本地OCR为local，大模型OCR则为cloud
# OCR_MODE=local

# ---- Agent 行为参数 ----
# 单次追问轮数上限（对话中追问"为什么/怎么做"的最大次数）
# AGENT_MAX_ASKS=3
# 单轮对话内工具执行的最大循环轮数
# AGENT_MAX_TOOL_ROUNDS=3

# ---- 超时与容量限制----
# 模型请求超时（毫秒），默认 120000
# REQUEST_TIMEOUT_MS=120000
# OCR 单张图片识别超时（毫秒），默认 30000
# OCR_TIMEOUT_MS=30000
# OCR 识别结果缓存条数，默认 50
# OCR_CACHE_LIMIT=50
# 图片附件大小上限（MB），超限跳过识别，默认 12
# IMAGE_MAX_MB=12
# PDF 文本提取字符数上限，默认 20000
# PDF_MAX_CHARS=20000
# 向量嵌入请求超时（毫秒），默认 8000
# EMBED_TIMEOUT_MS=8000
