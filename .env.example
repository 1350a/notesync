# notesync 环境变量模板
# 详见 doc/help-about-.env.md

# ---- DeepSeek（OpenAI 兼容）----
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---- 智谱 AI / BigModel（OpenAI 兼容）----
ZHIPU_API_KEY=your_zhipu_api_key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.3-flash

# ---- 自定义模型（仅兼容 OpenAI）----
CUSTOM_API_KEY=your_custom_api_key
CUSTOM_BASE_URL=https://your-openai-compatible-endpoint.example.com/v1
CUSTOM_MODEL=your_model_name

# ---- 工具调用 ----
TOOLS_ENABLED=true
TOOL_MAX_ROUNDS=5
CUSTOM_TOOL_MODE=native
CUSTOM_ALLOW_IMAGES=0

# ---- 上下文与请求透传 ----
TRIM_BUDGET_CHARS=24000
USER_FIELD_ENABLED=1

# ---- 本地模型资产 ----
HF_MIRROR=https://huggingface.co

# ---- 零 token 调试开关 ----
MOCK_MODEL=0
MOCK_IMAGE_MODE=
MOCK_OCR=0
MOCK_PARSE_DOC=0
