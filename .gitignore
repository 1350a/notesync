# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# 本地 OCR 运行时资产（由 npm run ocr:assets 从仓库/依赖内派生，见 doc/browser-local-ocr.md）
/public/ocr/

# 本地推理模型资产（由 npm run local:assets 从 HF/依赖内派生，见 doc/browser-local-inference.md）
/public/models/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
